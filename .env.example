DATABASE_URL=postgres://notea@127.0.0.1:5433/notea
DATABASE_URL_TEST=postgres://notea@127.0.0.1:5433/notea_test
NOTEA_CODE_PEPPER=change-this-pepper
NOTEA_SHOW_CODES=1
NOTEA_SEED=1
# YouTube Data API. The refresh token is the channel owner's offline token.
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# YOUTUBE_REFRESH_TOKEN=

# Email (Resend) - verification codes sent when a user registers with email
# RESEND_API_KEY=
# EMAIL_FROM="Notea <noreply@yourdomain>"

# SMS (Beem) - verification codes sent when a user registers with phone
# SMS_SENDER_ID=
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# BEEM_SOURCE_ADDR=
